#!/usr/bin/env bash
# Stub: 'version' prints ${STUB_OMP_VERSION:-31.8.0}; anything else exits 0.
set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'
# Log "NAME<TAB>%q-quoted args" so one spaced arg differs from two args.
args=""
if (($#)); then args=$(printf '%q ' "$@"); fi
printf '%s\t%s\n' "${0##*/}" "${args% }" >>"${STUB_LOG:-/dev/null}"
if [[ ${1:-} == version ]]; then echo "${STUB_OMP_VERSION:-31.8.0}"; fi
exit 0
