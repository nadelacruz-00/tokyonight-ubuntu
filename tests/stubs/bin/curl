#!/usr/bin/env bash
set -Eeuo pipefail
printf "%s\t%s\n" "${0##*/}" "$*" >>"${STUB_LOG:-/dev/null}"
out=""
url=""
while (($#)); do
  case $1 in
    -o)
      out=$2
      shift 2
      ;;
    -*) shift ;;
    *)
      url=$1
      shift
      ;;
  esac
done
src="${STUB_STATE:?}/downloads/${url##*/}"
[[ -f $src && -n $out ]] || exit 22
cp "$src" "$out"
