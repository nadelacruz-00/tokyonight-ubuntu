#!/usr/bin/env bash
# Stub: 'uname -m' prints ${STUB_UNAME_M:-aarch64}; anything else prints Linux.
set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'
# Log "NAME<TAB>%q-quoted args" so one spaced arg differs from two args.
args=""
if (($#)); then args=$(printf '%q ' "$@"); fi
printf '%s\t%s\n' "${0##*/}" "${args% }" >>"${STUB_LOG:-/dev/null}"
if [[ ${1:-} == -m ]]; then
  echo "${STUB_UNAME_M:-aarch64}"
else
  echo Linux
fi
