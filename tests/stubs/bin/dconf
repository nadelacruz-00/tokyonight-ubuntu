#!/usr/bin/env bash
# Stub: 'dconf read KEY' | 'write KEY VALUE' | 'reset [-f] KEY|DIR/' | 'dump DIR/' | 'list DIR/'.
# State: $STUB_STATE/dconf.tsv (key<TAB>value).
# shellcheck disable=SC2016 # awk programs are single-quoted on purpose
set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'
# Log "NAME<TAB>%q-quoted args" so one spaced arg differs from two args.
args=""
if (($#)); then args=$(printf '%q ' "$@"); fi
printf '%s\t%s\n' "${0##*/}" "${args% }" >>"${STUB_LOG:-/dev/null}"
db="${STUB_STATE:?}/dconf.tsv"
touch "$db"
filter() { # filter <awk-args...>: rewrite db through awk
  local tmp
  tmp=$(mktemp)
  awk -F'\t' -v OFS='\t' "$@" "$db" >"$tmp"
  mv "$tmp" "$db"
}
case "${1:-}" in
  read) awk -F'\t' -v k="${2:-}" '$1==k{v=$2} END{if(v!="")print v}' "$db" ;;
  write)
    filter -v k="$2" '$1!=k'
    printf '%s\t%s\n' "$2" "$3" >>"$db"
    ;;
  reset)
    shift
    if [[ ${1:-} == -f ]]; then shift; fi
    k=$1
    if [[ $k == */ ]]; then
      filter -v p="$k" 'index($1,p)!=1'
    else
      filter -v k="$k" '$1!=k'
    fi
    ;;
  dump)
    dir=${2:-/}
    awk -F'\t' -v p="$dir" 'index($1,p)==1{print (index(substr($1,length(p)+1),"/")?1:0) "\t" $0}' "$db" |
      LC_ALL=C sort | cut -f2- | awk -F'\t' -v p="$dir" 'BEGIN{last="\001"} index($1,p)==1{
      rest=substr($1,length(p)+1); n=index(rest,"/")
      sec=(n? substr(rest,1,n) : "")
      key=(n? substr(rest,n+1) : rest)
      if(sec!=last){print "[" (sec==""?"/":substr(sec,1,length(sec)-1)) "]"; last=sec}
      print key "=" $2 }'
    ;;
  list)
    dir=${2:-/}
    awk -F'\t' -v p="$dir" 'BEGIN{last="\001"} index($1,p)==1{
      rest=substr($1,length(p)+1); n=index(rest,"/")
      print (n? substr(rest,1,n) : rest) }' "$db" | LC_ALL=C sort -u
    ;;
esac
