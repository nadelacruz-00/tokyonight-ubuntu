#!/usr/bin/env bash
# Stub: 'flatpak info [--user] APP' succeeds iff $STUB_STATE/flatpak/APP exists;
# 'flatpak install [flags] [remote] APP' creates it. APP is always the LAST argument
# there. 'flatpak run APP ARGS...' runs $STUB_STATE/flatpak-run (if present) with
# APP ARGS..., so a test can play the app's side effects.
# STUB_FLATPAK_INSTALL_FAIL=1 makes 'flatpak install' fail without installing.
set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'
# Log "NAME<TAB>%q-quoted args" so one spaced arg differs from two args.
args=""
if (($#)); then args=$(printf '%q ' "$@"); fi
printf '%s\t%s\n' "${0##*/}" "${args% }" >>"${STUB_LOG:-/dev/null}"
app_dir="${STUB_STATE:?}/flatpak"
app=""
for a in "$@"; do app=$a; done
case "${1:-}" in
  run)
    shift
    if [[ -x $STUB_STATE/flatpak-run ]]; then "$STUB_STATE/flatpak-run" "$@"; fi
    ;;
  info) [[ -e $app_dir/$app ]] ;;
  install)
    if [[ -n ${STUB_FLATPAK_INSTALL_FAIL:-} ]]; then exit 1; fi
    mkdir -p "$app_dir"
    : >"$app_dir/$app"
    ;;
esac
