#!/usr/bin/env bash
# Stub: logs the call and exits 0. '--query NAME' prints $STUB_STATE/ua-query.NAME
# when it exists (else nothing), so a test can play a manual pin.
set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'
# Log "NAME<TAB>%q-quoted args" so one spaced arg differs from two args.
args=""
if (($#)); then args=$(printf '%q ' "$@"); fi
printf '%s\t%s\n' "${0##*/}" "${args% }" >>"${STUB_LOG:-/dev/null}"
if [[ ${1:-} == --query && -f ${STUB_STATE:?}/ua-query.${2:-} ]]; then
  cat -- "$STUB_STATE/ua-query.$2"
fi
