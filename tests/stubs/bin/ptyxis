#!/usr/bin/env bash
# Stub: logs the call and exits 0.
set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'
# Log "NAME<TAB>%q-quoted args" so one spaced arg differs from two args.
args=""
if (($#)); then args=$(printf '%q ' "$@"); fi
printf '%s\t%s\n' "${0##*/}" "${args% }" >>"${STUB_LOG:-/dev/null}"
# A test can play the app's side effects (e.g. writing window-size).
if [[ -x ${STUB_STATE:-/nonexistent}/ptyxis-run ]]; then "$STUB_STATE/ptyxis-run" "$@"; fi
