# Ubuntu 26.04 image for tests/integration/run.sh (make test-container).
# The repository is mounted at /src at run time; nothing of it is baked in.
FROM ubuntu:26.04

# dconf-cli dbus libglib2.0-bin libglib2.0-dev-bin python3 curl xz-utils zsh
# ptyxis gnome-shell-extensions gnome-shell-common yaru-theme-gnome-shell
# ubuntu-wallpapers-resolute fontconfig sudo git (+ gsettings-desktop-schemas,
# ca-certificates); ptyxis, yaru-theme-gnome-shell and ubuntu-wallpapers-resolute
# are optional. The list lives in install-deps.sh, shared with CI.
COPY install-deps.sh /usr/local/sbin/tnu-install-deps
RUN chmod 0755 /usr/local/sbin/tnu-install-deps && tnu-install-deps tester

USER tester
WORKDIR /src
ENV TNU_IN_CONTAINER=1
CMD ["bash", "-c", "tests/integration/run.sh && tests/integration/run.sh --system"]
